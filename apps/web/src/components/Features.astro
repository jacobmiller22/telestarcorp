---
interface Feature {
  id: string;
  badge: string;
  title: string;
  subtitle: string;
  description: string;
  bullets: string[];
  image?: string;
  imageAlt?: string;
  reverseLayout?: boolean;
}

const features: Feature[] = [
  {
    id: 'unified-communications',
    badge: 'All-in-One Platform',
    title: 'Unified Communications',
    subtitle: 'Talk, text, meet, and collaborate from any device.',
    description:
      'Eliminate fragmented tools. Telestar combines crystal-clear cloud PBX voice, business SMS, video conferencing, and mobile/desktop apps into one intuitive platform that travels everywhere you go.',
    bullets: [
      'Reliable Cloud PBX with custom automated attendants and voicemail to email',
      'Business SMS & text messaging from your company phone numbers',
      'Desktop and mobile apps keep you connected at the office, home, or on the road',
      'Intuitive administrative control panel with quick user and extension provisioning',
    ],
    reverseLayout: false,
  },
  {
    id: 'contact-center',
    badge: 'Customer Experience',
    title: 'Streamline Workflows with Contact Center',
    subtitle: 'Differentiate your business where it matters most – the customer experience.',
    description:
      'Deliver professional, frictionless support to every caller. Telestar Contact Center equips your team with intelligent routing, custom call queues, call recording, and practical call reporting without enterprise complexity.',
    bullets: [
      'Intelligent call distribution, hunt groups, and interactive automated IVR menus',
      'Automatic call recording for compliance, training, and quality assurance',
      'Call queue management and real-time agent availability tracking',
      'Clear, actionable reporting on incoming call volumes and response times',
    ],
    image: '/assets/contact-center.png',
    imageAlt: 'Telestar Contact Center management interface and analytics',
    reverseLayout: true,
  },
  {
    id: 'file-backup',
    badge: 'Data Protection Pillar',
    title: 'SecuriSync File Sharing & Real-Time Backup',
    subtitle: 'Keep business data protected, synchronized, and instantly accessible.',
    description:
      "A core pillar of Telestar's all-in-one business platform. Securely synchronize files across desktop and mobile devices, share folders with clients, and protect critical company records against hardware failure and ransomware.",
    bullets: [
      'Real-time automatic cloud backup for desktop and laptop business files',
      'Point-in-time version restore to recover instantly from ransomware or accidental deletion',
      'Secure, password-protected file sharing links with expiration dates for clients',
      'Seamless multi-device synchronization across Windows, Mac, iOS, and Android',
    ],
    reverseLayout: false,
  },
  {
    id: 'teams-integration',
    badge: 'Teams Voice',
    title: 'Integrate Microsoft Teams with Your Phone',
    subtitle: 'Connect with teams and customers all in one place.',
    description:
      'Keep the collaboration tools your team already uses every day. Telestar bridges directly into Microsoft Teams, enabling high-quality inbound and outbound calling directly from Teams without paying premium enterprise calling plan markups.',
    bullets: [
      'Direct voice routing with zero extra softphones or clunky dialers needed',
      'Retain existing business phone numbers with seamless number porting',
      'Substantial cost savings compared to standard Microsoft Calling Plans',
      'Single unified platform for internal team chat and external client calls',
    ],
    reverseLayout: true,
  },
  {
    id: 'custom-solutions',
    badge: 'Let Us Come To You',
    title: 'Customized Telecom Solutions',
    subtitle: 'Not all businesses are the same. We create customized solutions for your business today.',
    description:
      'Whether you are a solopreneur or a growing team of 100, Telestar has you covered. Give us a call, and Keith Miller and our team can discuss your specific communication needs in person.',
    bullets: [
      'Personalized telecom consultation and local on-site system design ("Let us come to you")',
      'Tailored solutions designed for your exact number of extensions, lines, and offices',
      'Dedicated local support from Keith Miller and the experienced Telestar team',
      'Straightforward, transparent pricing with zero hidden surcharges or surprise fees',
    ],
    image: '/assets/customized-solutions.png',
    imageAlt: 'Telestar customized telecom deployment and system design',
    reverseLayout: false,
  },
];
---

<section id="features" class="py-20 lg:py-28 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-24">
      <span class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-3">
        Solutions & Capabilities
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Modern communications that power everyday business.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Say goodbye to restrictive traditional phone systems, overpriced carrier contracts, and confusing hardware. Telestar delivers reliable cloud communications built to scale.
      </p>
    </div>

    <!-- Feature Rows -->
    <div class="space-y-20 lg:space-y-28">
      {
        features.map((feature, idx) => (
          <div
            id={feature.id}
            class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center ${
              feature.reverseLayout ? 'lg:grid-flow-dense' : ''
            }`}
          >
            <!-- Copy Column -->
            <div
              class={`lg:col-span-6 space-y-5 ${
                feature.reverseLayout ? 'lg:col-start-7' : ''
              }`}
            >
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 text-slate-800 text-xs font-semibold tracking-wide">
                <span>0{idx + 1}</span>
                <span class="text-slate-400">/</span>
                <span>{feature.badge}</span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight leading-snug">
                {feature.title}
              </h3>

              <p class="text-base font-semibold text-blue-600">
                {feature.subtitle}
              </p>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {feature.description}
              </p>

              <ul class="space-y-3 pt-2 text-sm text-slate-700">
                {feature.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <div class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center text-blue-600">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </div>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-4">
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700 group"
                >
                  Request a consultation for {feature.title}
                  <svg
                    class="w-4 h-4 transition-transform group-hover:translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Visual / Image Column -->
            <div
              class={`lg:col-span-6 flex justify-center ${
                feature.reverseLayout ? 'lg:col-start-1' : ''
              }`}
            >
              {feature.image ? (
                <div class="w-full max-w-lg rounded-2xl bg-gradient-to-tr from-slate-100 via-blue-50/50 to-white p-4 sm:p-6 border border-slate-200/80 shadow-md">
                  <img
                    src={feature.image}
                    alt={feature.imageAlt || feature.title}
                    class="w-full h-auto object-contain rounded-lg"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="w-full max-w-lg rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-slate-900 p-8 text-white shadow-xl flex flex-col justify-between min-h-[320px]">
                  <div class="space-y-4">
                    <div class="w-12 h-12 rounded-xl bg-white/10 backdrop-blur-md flex items-center justify-center text-white">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                    </div>
                    <h4 class="text-2xl font-bold">{feature.title}</h4>
                    <p class="text-sm text-blue-100 leading-relaxed">
                      Instant deployment. Whether you want sleek desktop deskphones, mobile apps for field technicians, or web browser softphones, Telestar is ready out of the box.
                    </p>
                  </div>
                  <div class="pt-6 border-t border-white/10 flex items-center justify-between text-xs text-blue-200 font-medium">
                    <span>99.999% SLA Carrier Uptime</span>
                    <span>Zero Hardware Lock-In</span>
                  </div>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
