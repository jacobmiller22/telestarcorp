---
interface Testimonial {
  name: string;
  role: string;
  company: string;
  image: string;
  quote: string;
  highlight: string;
}

const testimonials: Testimonial[] = [
  {
    name: 'Shannon Adee',
    role: 'Founder',
    company: 'Spark Solutions',
    image: '/assets/testimonials/shannon-adee.jpeg',
    quote:
      "Telestar is our go-to for all things business phone, sms, and conferencing. We were unhappy with some of their competitors because service was unrelieable, and the admin panels were clunky. Telestar is constantly updating their systems, and customer service is top-notch. It's an added bonus too that the cost is less than what we were paying before - for more features. We highly recommend Telestar and the entire team!",
    highlight: 'Top-Notch Customer Service & More Features',
  },
  {
    name: 'Ben Handzel',
    role: 'Owner',
    company: 'Restoration 1 – South Richmond',
    image: '/assets/testimonials/ben-handzel.png',
    quote:
      'After switching from a competitor to Telestar, we actually started receiving more calls, booked more appointments, and have increased our revenue. Customer service is outstanding. I highly recommend you having a conversation with Telestar if you own a service based business.',
    highlight: 'Increased Calls & Outstanding Service',
  },
  {
    name: 'Shannon Springer',
    role: 'CFO',
    company: 'The Springer Agency',
    image: '/assets/testimonials/shannon-springer.png',
    quote:
      'If you are looking for a phone provider that gets things done, Keith Miller and Telestar are your must use! We have been using Telestar for several years now for our extremely busy insurance agency. With 3 locations in Virginia, having our phones on point is critical. Having switched from a “larger company” due to poor customer service and phone issues, Keith is committed to that not being a problem with for his clients. Huge thanks for Telestar for keeping us in communication with our clients.',
    highlight: 'Keith Miller & Telestar Get Things Done',
  },
];
---

<section id="testimonials" class="py-20 lg:py-28 bg-slate-50 border-t border-slate-200/60 relative overflow-hidden">
  <!-- Background Glow -->
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-brand-cyan-light/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3 py-1 rounded-full bg-brand-cyan-light text-brand-cyan-dark text-xs font-semibold uppercase tracking-wider mb-3">
        Client Stories
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Trusted by businesses across the nation.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Discover why business leaders choose Telestar over legacy telecom giants. Real experiences from real teams who rely on our platform every day.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        testimonials.map((t) => (
          <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
            <div class="space-y-4">
              <!-- Rating Stars -->
              <div class="flex items-center gap-1 text-amber-400">
                {[...Array(5)].map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>

              <!-- Tagline Highlight -->
              <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded bg-brand-cyan-light text-brand-cyan-dark">
                {t.highlight}
              </span>

              <!-- Quote Body -->
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed italic">
                "{t.quote}"
              </p>
            </div>

            <!-- Author Card -->
            <div class="pt-6 mt-6 border-t border-slate-100 flex items-center gap-4">
              <img
                src={t.image}
                alt={t.name}
                class="w-13 h-13 rounded-full object-cover border-2 border-white shadow-sm ring-2 ring-slate-100"
                loading="lazy"
              />
              <div>
                <h4 class="text-sm font-bold text-slate-900 group-hover:text-brand-cyan-dark transition-colors">
                  {t.name}
                </h4>
                <p class="text-xs font-medium text-slate-500">
                  {t.role}, <span class="text-slate-700">{t.company}</span>
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Grounded Proof Points Banner -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-brand-cyan-dark">2012</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Serving Regional Businesses</p>
      </div>
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-brand-cyan-dark">Local</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Dedicated Personal Support</p>
      </div>
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-brand-cyan-dark">All-in-1</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Phone, Video & File Backup</p>
      </div>
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-brand-cyan-dark">0</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Hardware Lock-In</p>
      </div>
    </div>
  </div>
</section>
