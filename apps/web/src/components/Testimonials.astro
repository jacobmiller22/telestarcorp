---
interface Testimonial {
  name: string;
  role: string;
  company: string;
  image: string;
  quote: string;
  highlight: string;
}

const testimonials: Testimonial[] = [
  {
    name: 'Shannon Adee',
    role: 'Founder',
    company: 'Spark Solutions',
    image: '/assets/testimonials/shannon-adee.jpeg',
    quote:
      "I don't think I can say enough about the ease of use of the Telestar system. But even more than that, their customer service is top notch. It's like having an IT department down the hall.",
    highlight: 'Top-Notch Customer Service',
  },
  {
    name: 'Ben Handzel',
    role: 'Owner',
    company: 'Restoration 1 – South Richmond',
    image: '/assets/testimonials/ben-handzel.png',
    quote:
      'Telestar has been a game-changer for our emergency restoration business. Quick dispatch, crystal clear calls, and incredible support day or night. We never miss an urgent client call.',
    highlight: 'Reliable 24/7 Dispatch',
  },
  {
    name: 'Shannon Springer',
    role: 'CFO',
    company: 'The Springer Agency',
    image: '/assets/testimonials/shannon-springer.png',
    quote:
      'Switching to Telestar slashed our telecom overhead while dramatically increasing reliability. The Microsoft Teams integration seamlessly fits our existing workflow across all our branch offices.',
    highlight: 'Slashed Overhead & Teams Integration',
  },
];
---

<section id="testimonials" class="py-20 lg:py-28 bg-slate-50 border-t border-slate-200/60 relative overflow-hidden">
  <!-- Background Glow -->
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-3">
        Client Stories
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Trusted by businesses across the nation.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Discover why business leaders choose Telestar over legacy telecom giants. Real experiences from real teams who rely on our platform every day.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        testimonials.map((t) => (
          <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
            <div class="space-y-4">
              <!-- Rating Stars -->
              <div class="flex items-center gap-1 text-amber-400">
                {[...Array(5)].map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>

              <!-- Tagline Highlight -->
              <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded bg-blue-50 text-blue-700">
                {t.highlight}
              </span>

              <!-- Quote Body -->
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed italic">
                "{t.quote}"
              </p>
            </div>

            <!-- Author Card -->
            <div class="pt-6 mt-6 border-t border-slate-100 flex items-center gap-4">
              <img
                src={t.image}
                alt={t.name}
                class="w-13 h-13 rounded-full object-cover border-2 border-white shadow-sm ring-2 ring-slate-100"
                loading="lazy"
              />
              <div>
                <h4 class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                  {t.name}
                </h4>
                <p class="text-xs font-medium text-slate-500">
                  {t.role}, <span class="text-slate-700">{t.company}</span>
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Trust Stats Banner -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-blue-600">99.999%</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Uptime Reliability</p>
      </div>
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-blue-600">&lt; 30s</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Average Support Response</p>
      </div>
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-blue-600">100%</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Free White-Glove Setup</p>
      </div>
      <div class="p-6 rounded-xl bg-white border border-slate-200/60 shadow-xs">
        <p class="text-3xl font-extrabold text-blue-600">0</p>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Hardware Lock-In</p>
      </div>
    </div>
  </div>
</section>
