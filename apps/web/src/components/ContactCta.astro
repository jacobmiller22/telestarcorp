---
---

<section class="py-20 lg:py-24 bg-gradient-to-br from-brand-navy via-slate-900 to-brand-navy text-white relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-brand-cyan/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center space-y-6">
      <span class="inline-block px-3.5 py-1.5 rounded-full bg-brand-cyan/20 text-brand-cyan-light border border-brand-cyan/30 text-xs font-semibold uppercase tracking-wider">
        Ready For Smarter Telecom?
      </span>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Experience modern business communications without the headache.
      </h2>

      <p class="text-base sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        Not all businesses are the same. Let us come to you and create a customized telecom solution for your business today.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:+18049308400"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-base font-bold text-brand-navy bg-white hover:bg-brand-cyan-light rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 text-brand-cyan-dark" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
          </svg>
          Call (804) 930-8400
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-brand-cyan/30 hover:bg-brand-cyan/50 border border-brand-cyan/40 rounded-xl backdrop-blur-xs transition-all"
        >
          Schedule Consultation
        </a>
      </div>

      <div class="pt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs text-slate-300">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          No Commitment Necessary
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Fast 1-Business-Day Turnaround
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Direct US-Based Support
        </div>
      </div>
    </div>
  </div>
</section>
