---
---

<section class="relative overflow-hidden bg-gradient-to-b from-blue-50/70 via-white to-slate-50 pt-16 pb-20 lg:pt-24 lg:pb-32">
  <!-- Subtle decorative background blurs -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-tr from-blue-200/30 to-indigo-100/20 blur-3xl -z-10 pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Tagline Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-blue-700 text-xs font-semibold uppercase tracking-wider">
          <span class="inline-block w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
          Rethinking Communications With Telestar
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1]">
          We help small businesses <span class="text-blue-600">communicate better</span> every day.
        </h1>

        <!-- Subheading -->
        <p class="text-lg sm:text-xl text-slate-600 font-medium max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          An all-in-one communications platform designed for modern business. Work better. From wherever.
        </p>

        <!-- Direct Consultation CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="tel:+18049308400"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl shadow-md hover:shadow-lg transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
            </svg>
            Call (804) 930-8400
          </a>
          <a
            href="/contact"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 font-semibold text-sm rounded-xl shadow-xs hover:shadow-sm transition-all"
          >
            Schedule Consultation
          </a>
        </div>
        <p class="mt-2 text-xs text-slate-500 text-center lg:text-left">
          No long-term hardware contracts. Dedicated personal support from Keith Miller & team.
        </p>
      </div>

      <!-- Right Column: Visual Artwork -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-md lg:max-w-none">
          <div class="relative rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-700 p-1 shadow-2xl">
            <div class="rounded-2xl bg-white p-6 sm:p-8 space-y-6">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold">
                    T
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-slate-900">Telestar Unified App</h3>
                    <p class="text-xs text-emerald-600 flex items-center gap-1 font-medium">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Live Edge System
                    </p>
                  </div>
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-700">HD Voice</span>
              </div>

              <!-- Illustration from Archive -->
              <div class="flex justify-center py-2">
                <img
                  src="/assets/hero-phones.png"
                  alt="Telestar mobile and desktop communications"
                  class="w-64 h-auto object-contain drop-shadow-md"
                />
              </div>

              <!-- Feature bullets inside card -->
              <div class="grid grid-cols-2 gap-3 pt-2 text-xs font-medium text-slate-700">
                <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100">
                  <p class="text-slate-900 font-bold text-sm">Cloud PBX</p>
                  <p class="text-slate-500">Hosted Voice & SMS</p>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100">
                  <p class="text-slate-900 font-bold text-sm">Teams & Web</p>
                  <p class="text-slate-500">Native Integration</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- The Telecom Company That Scares the Big Guys Callout -->
    <div class="mt-20 lg:mt-28 p-8 sm:p-12 rounded-2xl bg-slate-900 text-white shadow-xl relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="max-w-3xl space-y-4">
        <span class="text-blue-400 font-semibold text-xs uppercase tracking-widest">Our Mission</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          "We're the telecom company that scares the big guys."
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Telestar is the all-in-one unified communication and collaboration solution that combines a feature-rich cloud-based phone system with web and video conferencing, file sharing & backup, and so much more. Telestar goes where you go, with desktop and mobile apps that keep you seamlessly connected without enterprise markups.
        </p>
      </div>
    </div>
  </div>
</section>
